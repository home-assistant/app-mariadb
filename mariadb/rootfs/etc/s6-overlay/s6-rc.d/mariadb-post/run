#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Post-start initialization of MariaDB service
# ==============================================================================

# Wait until DB is running
while ! mariadb -e "" 2> /dev/null; do
    sleep 1
done
bashio::log.info "MariaDB started"

# Delete service information, just in case the previous instance somehow did not cleanup
# Note: you can't redirect LOG_FD without eval
eval "bashio::services.delete mysql &> /dev/null ${LOG_FD}> /dev/null" || true

bashio::log.info "Check data integrity and fix corruptions"
mariadb-check --no-defaults --databases mysql --fix-db-names --fix-table-names || true
mariadb-check --no-defaults --databases mysql --check --check-upgrade --auto-repair || true
mariadb-check --no-defaults --all-databases --skip-database=mysql --fix-db-names --fix-table-names || true
mariadb-check --no-defaults --all-databases --skip-database=mysql --check --check-upgrade --auto-repair || true

bashio::log.info "Ensuring internal database upgrades are performed"
mariadb-upgrade --silent

# Set default secure values after initial setup
if bashio::var.true "${NEW_INSTALL}"; then
    # Secure the installation.
    mariadb <<-EOSQL
        SET @@SESSION.SQL_LOG_BIN=0;
        DELETE FROM
            mysql.user
        WHERE
            user NOT IN ('mysql.sys', 'mariadb.sys', 'mysqlxsys', 'root', 'mysql', 'proxies_priv')
                OR host NOT IN ('localhost');
        DELETE FROM
            mysql.proxies_priv
        WHERE
            user NOT IN ('mysql.sys', 'mariadb.sys', 'mysqlxsys', 'root', 'mysql', 'proxies_priv')
                OR host NOT IN ('localhost');
        DROP DATABASE IF EXISTS test;
        FLUSH PRIVILEGES;
EOSQL
fi

# Escape a value for use inside a single quoted SQL string literal. Only
# passwords need this, the options schema restricts database and user names.
function sql_string() {
    local value="${1//\\/\\\\}"
    printf '%s' "${value//\'/\'\'}"
}

# Run SQL statements. A failure is logged but not fatal, so that a mistake in
# one option does not keep the database from starting. The statements are
# passed on stdin, so that passwords do not show up in the process list. Only
# the error message is logged, as the client would otherwise print the failed
# statement, which may hold a password.
function sql_execute() {
    local description="${1}"
    local output

    if ! output=$(mariadb 2>&1 <<< "${2}"); then
        bashio::log.error "Failed to ${description}: $(grep '^ERROR' <<< "${output}" || true)"
    fi
}

# Init databases
bashio::log.info "Ensure databases exists"
for database in $(bashio::config "databases"); do
    bashio::log.info "Create database ${database}"
    sql_execute "create database ${database}" \
        "CREATE DATABASE IF NOT EXISTS \`${database}\`;"
done

# Init logins
bashio::log.info "Ensure users exists and are updated"
for login in $(bashio::config "logins|keys"); do
    USERNAME=$(bashio::config "logins[${login}].username")
    PASSWORD=$(sql_string "$(bashio::config "logins[${login}].password")")

    bashio::log.info "Create or update user ${USERNAME}"
    sql_execute "create or update user ${USERNAME}" "
        CREATE USER IF NOT EXISTS '${USERNAME}'@'%' IDENTIFIED BY '${PASSWORD}';
        SET PASSWORD FOR '${USERNAME}'@'%' = PASSWORD('${PASSWORD}');
    "
done

# Init rights
bashio::log.info "Init/Update rights"
for right in $(bashio::config "rights|keys"); do
    USERNAME=$(bashio::config "rights[${right}].username")
    DATABASE=$(bashio::config "rights[${right}].database")

    if bashio::config.exists "rights[${right}].privileges"; then
        PRIVILEGES=$(bashio::config "rights[${right}].privileges | (if type == \"array\" then join(\", \") else . end)")
        bashio::log.info "Granting ${PRIVILEGES} to ${USERNAME} on ${DATABASE}"
        # Fails if the user has no privileges on the database yet, which is fine
        mariadb -e "REVOKE ALL PRIVILEGES ON \`${DATABASE}\`.* FROM '${USERNAME}'@'%';" &> /dev/null || true
    else
        PRIVILEGES="ALL PRIVILEGES"
        bashio::log.info "Granting all privileges to ${USERNAME} on ${DATABASE}"
    fi

    sql_execute "grant ${PRIVILEGES} to ${USERNAME} on ${DATABASE}" \
        "GRANT ${PRIVILEGES} ON \`${DATABASE}\`.* TO '${USERNAME}'@'%';"
done

# Generate service user
if ! bashio::fs.file_exists "/data/secret"; then
    pwgen 64 1 > /data/secret
fi
SECRET=$(</data/secret)
sql_execute "set up the service user" "
    CREATE USER IF NOT EXISTS 'service'@'172.30.32.%' IDENTIFIED BY '${SECRET}';
    CREATE USER IF NOT EXISTS 'service'@'172.30.33.%' IDENTIFIED BY '${SECRET}';
    GRANT ALL PRIVILEGES ON *.* TO 'service'@'172.30.32.%' WITH GRANT OPTION;
    GRANT ALL PRIVILEGES ON *.* TO 'service'@'172.30.33.%' WITH GRANT OPTION;
"

# Flush privileges
mariadb -e "FLUSH PRIVILEGES;" 2> /dev/null || true

# Send service information to the Supervisor
PAYLOAD=$(\
    bashio::var.json \
        host "$(hostname)" \
        port "^3306" \
        username "service" \
        password "${SECRET}"
)
bashio::log.info "Sending service information to Home Assistant"
bashio::services.publish "mysql" "${PAYLOAD}"
