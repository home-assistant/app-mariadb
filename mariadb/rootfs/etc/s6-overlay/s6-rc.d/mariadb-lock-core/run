#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start MariaDB client (to lock tables for backups)
# ==============================================================================

bashio::log.info "Start MariaDB client (to lock tables for backups)"

# The client runs as a coprocess, with file descriptor &4 as its stdin and &5
# as its stdout. mariadb-lock-post is a separate process and reaches them
# through /proc to send statements and to read their result.
# Close the s6 notification fd &3 in the client so it is not inherited
coproc mariadb --unbuffered --skip-column-names 3>&-
exec 4>&"${COPROC[1]}"- 5<&"${COPROC[0]}"-

# We need to delay the starting of the dependent services until mysql is started
echo "" >&3
exec 3>&-
wait
