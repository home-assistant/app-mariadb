#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Lock tables for backups
# ==============================================================================
# Same as the recorder uses for its SQLite database
readonly LOCK_TIMEOUT=30

declare MARIADB_LOCK_CORE_PID
declare result

MARIADB_LOCK_CORE_PID=$(s6-svstat -o pid "/run/service/mariadb-lock-core")
# shellcheck disable=SC2086
if bashio::var.equals ${MARIADB_LOCK_CORE_PID} -1; then
    bashio::log.error "Invalid mariadb-lock-core process id ${MARIADB_LOCK_CORE_PID}"
    bashio::exit.nok
fi

# File descriptor &4 is the stdin of the client and &5 its stdout. The client
# runs the statements in order, so the result only shows up once the lock is
# held. This can take a while if statements are still running, and new writes
# are blocked meanwhile. The server gives up after the timeout, which makes
# the client quit.
# shellcheck disable=SC2086
echo "SET lock_wait_timeout = ${LOCK_TIMEOUT}; FLUSH TABLES WITH READ LOCK; SELECT 'locked';" \
    > /proc/${MARIADB_LOCK_CORE_PID}/fd/4

# shellcheck disable=SC2086
if ! read -r -t "${LOCK_TIMEOUT}" result <> /proc/${MARIADB_LOCK_CORE_PID}/fd/5 \
    || ! bashio::var.equals "${result}" "locked"; then
    bashio::log.error "MariaDB tables not locked within ${LOCK_TIMEOUT} seconds"
    bashio::exit.nok
fi

bashio::log.info "MariaDB tables locked"
